{
  "expo": {
    "name": "HustleUG",
    "slug": "HustleUG",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#E6F4FE"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "HustleUG needs camera access so you can take photos and record videos for your job posts.",
          "microphonePermission": "HustleUG needs microphone access to record video with sound for your job posts.",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      "expo-audio"
    ]
  }
}
